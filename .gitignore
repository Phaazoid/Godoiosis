# Godot 4+ specific ignores
.godot/
/android/

# Godot generated files
.import/
.export/
.export_presets.cfg

# Mono / C# (safe even if unused)
.mono/
data_*/

# OS junk
.DS_Store
Thumbs.db

# Editor backups
*.tmp
*.bak
*.old

# Logs
*.log

# gdUnit4 test reports (generated)
/reports/

# Play API interactive bridge runtime files (#46 M3)
/playrun/

# Report-a-bug dumps (#128) - transient playtest artifacts. The .gdignore is tracked so the
# Godot editor never tries to import the screenshots that land here.
/bug-reports/*
!/bug-reports/.gdignore

# Wrangler CLI local cache (#131) - not build output, and wrangler-account.json carries the
# Cloudflare account id + owner email, which a public repo should not publish.
#
# UNANCHORED ON PURPOSE, and it took two failures to get here. It was path-coupled to the folder
# name, so #53 slice 5's report-worker -> intake-worker rename missed it and the cache came back
# untracked, one `git add -A` from being published. #1060 broke it a second way with no rename at
# all: wrangler writes its cache into the CURRENT DIRECTORY, not beside --config, so announcing a
# release from the repo root put a second one at the root that this line did not cover.
#
# A leading-slash-free pattern matches at every depth, so neither a move nor a working directory can
# reach past it again. The rule is "wrangler's cache is never committed, wherever it lands" -- which
# is what was always meant, and what the anchored spelling kept failing to say.
.wrangler/
/git flow.txt

# Content fixtures a test AUTHORS into the scanned content tree and removes again (#604). Ignored
# rather than merely cleaned up, so a run that dies before after_test still cannot dirty the tree.
/Resources/**/__test_*.tres

# agy (Antigravity CLI) session state — a local agent harness's own cache, not project output.
# Ignored so that driving a playtest through that harness doesn't leave untracked noise in
# `git status` (dev, 2026-08-27). The Play API's own runtime files are /playrun/ above.
/.antigravitycli/
