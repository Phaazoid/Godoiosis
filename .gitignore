# Godot 4+ specific ignores
.godot/
/android/

# Godot generated files
.import/
.export/
.export_presets.cfg

# Mono / C# (safe even if unused)
.mono/
data_*/

# OS junk
.DS_Store
Thumbs.db

# Editor backups
*.tmp
*.bak
*.old

# Logs
*.log

# gdUnit4 test reports (generated)
/reports/

# Play API interactive bridge runtime files (#46 M3)
/playrun/

# Report-a-bug dumps (#128) - transient playtest artifacts. The .gdignore is tracked so the
# Godot editor never tries to import the screenshots that land here.
/bug-reports/*
!/bug-reports/.gdignore

# Wrangler CLI local cache (#131 report-worker) - not build output, and wrangler-account.json
# carries the Cloudflare account id + owner email, which a public repo should not publish.
tools/report-worker/.wrangler/
/git flow.txt
